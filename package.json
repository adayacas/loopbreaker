  "repository": {
    "type": "git",
    "url": "git+https://github.com/adayacas/loopbreaker.git"
  },
  "homepage": "https://github.com/adayacas/loopbreaker#readme",
  "bugs": {
    "url": "https://github.com/adayacas/loopbreaker/issues"
  },
  "version": "0.3.0",
  "description": "Its an Opencode loopbreaker tool to stop ai models when the context overload,  to save tokens and guard the healt processes",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "bin": {
    "loopbreaker": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/*.test.js\"",
    "prepublishOnly": "rm -rf dist && npm test && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agent",
    "loop-detection",
    "circuit-breaker",
    "guardrails",
    "scope"
  ],
  "publishConfig": {
    "access": "public"
  }
}